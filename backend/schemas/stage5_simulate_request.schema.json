{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgePilot Stage 5 Simulate Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "changes"],
  "properties": {
    "request": {
      "type": "object",
      "required": ["workload"],
      "properties": {"workload": {"type": "object"}},
      "additionalProperties": true
    },
    "changes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 22,
      "additionalProperties": false,
      "properties": {
        "latency_requirement_ms": {"type": "number", "exclusiveMinimum": 0},
        "budget_monthly": {"type": "number", "minimum": 0},
        "bandwidth_requirement": {"enum": ["low", "medium", "high"]},
        "privacy_requirement": {"enum": ["low", "medium", "high"]},
        "criticality": {"enum": ["low", "medium", "high"]},
        "model_ram_required_mb": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "device_available_ram_mb": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "concurrent_users": {"type": "integer", "minimum": 0},
        "bandwidth_available_mbps": {"type": "number", "minimum": 0},
        "minimum_network_bandwidth_mbps": {"type": "number", "exclusiveMinimum": 0},
        "minimum_availability_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "require_offline": {"type": "boolean"},
        "allow_remote_processing": {"type": "boolean"},
        "network_available": {"type": "boolean"},
        "application_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_device": {"type": "string", "minLength": 1, "maxLength": 128},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 128},
        "precision": {"type": "string", "minLength": 1, "maxLength": 128},
        "allowed_tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["on_device", "far_edge", "regional_edge", "cloud"]}},
        "allowed_data_regions": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    },
    "metrics_by_tier": {"type": ["object", "null"]},
    "scenario_metrics_by_tier": {"type": ["object", "null"]}
  }
}
